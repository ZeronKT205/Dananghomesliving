# Sao chép file này thành .env.local rồi điền giá trị thật.
# QUY TẮC: chỉ biến có tiền tố NEXT_PUBLIC_ mới lộ ra trình duyệt.
# Biến public khai trong src/config/env.ts, secret khai trong src/config/env.server.ts (Zod).
# File này LÀ placeholder — không bao giờ điền giá trị thật vào đây.

# ---------- Public (lộ ra client) ----------
# MỘT url chính tắc của môi trường hiện tại (canonical/metadataBase/sitemap).
# Không phải danh sách — mỗi môi trường khai một giá trị khác nhau.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Host công khai của bucket R2, để ảnh đi thẳng qua CDN Cloudflare.
# Lấy sau khi bật R2 > Settings > Public Access (dạng https://pub-<mã>.r2.dev),
# hoặc gắn custom domain (https://cdn.dananghomesliving.com).
#
# ĐỂ TRỐNG cũng chạy được: ảnh sẽ phát qua route /api/media/... của chính ứng
# dụng. Chậm hơn vì không qua CDN, nhưng upload xong là thấy ảnh ngay.
# ĐỪNG chép nguyên chuỗi ví dụ vào đây — ảnh sẽ upload thành công mà không bao
# giờ hiện. Code có chặn dạng `pub-xxxx` nhưng đừng dựa vào đó.
NEXT_PUBLIC_R2_PUBLIC_URL=""

# ---------- Origin được phép gọi API (CORS / chống CSRF) ----------
# Danh sách phân tách bằng dấu phẩy, so khớp chính xác (không wildcard).
ALLOWED_ORIGINS="http://localhost:3000,https://dananghomesliving.vercel.app,https://dananghomesliving.com"

# ---------- MongoDB Atlas ----------
# Lấy ở Atlas > Database > Connect > Drivers. Password có ký tự đặc biệt phải URL-encode.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<appName>"
MONGODB_DB="dananghomesliving"

# ---------- Auth / JWT ----------
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Tối thiểu 32 ký tự. Mỗi môi trường (dev/staging/prod) dùng khoá KHÁC nhau.
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
AUTH_SECRET=""

# ---------- Cloudflare R2 ----------
# Cloudflare Dashboard > R2 > Manage API Tokens. Account ID nằm trong endpoint S3.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="dananghomesliving"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# Chỉ cần khi gọi REST API Cloudflare (quản trị bucket/CORS), không cần để upload.
CLOUDFLARE_API_TOKEN=""

# ---------- Khác ----------
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVALIDATE_SECRET=""
# AES-256 hex 64 ký tự: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ---------- AI: dựng bài + dịch tự động ----------
# Không có khoá nào thì CMS vẫn chạy, chỉ ẩn nút "Dựng bài" và "Dịch".

# Claude — nhà cung cấp mặc định. Lấy khoá tại https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Bỏ trống là dùng claude-haiku-4-5-20251001.
ANTHROPIC_MODEL=""

# Gemini — đường dự phòng. Lấy khoá tại https://aistudio.google.com/apikey
# Gói miễn phí chỉ 20 lượt/ngày MỖI MODEL, đủ để thử chứ không đủ dùng thật.
GEMINI_API_KEY=""
# Bản flash tuân đúng quy tắc tên riêng ở cả 4 ngôn ngữ; flash-lite nhanh hơn
# nhưng bỏ qua quy tắc đó với tiếng Trung/Hàn — đừng dùng.
TRANSLATION_MODEL="gemini-3.5-flash"

# Ép chọn nhà cung cấp: anthropic | gemini. Bỏ trống thì tự chọn Anthropic khi
# có ANTHROPIC_API_KEY, không thì rơi về Gemini.
AI_PROVIDER=""

# ---------- Email thông báo yêu cầu tư vấn ----------
# Không cấu hình thì CMS vẫn nhận yêu cầu bình thường, chỉ không gửi email.
# Gmail: bật xác minh 2 bước rồi tạo "App password" (16 ký tự), KHÔNG dùng mật
# khẩu đăng nhập thường — Google chặn.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Người nhận thông báo. Bỏ trống thì gửi về chính SMTP_USER.
INQUIRY_NOTIFY_TO=""
